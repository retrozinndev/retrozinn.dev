{
	"name": "web",
        "$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-29",
	"compatibility_flags": [
            "global_fetch_strictly_public"
        ],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
        "secrets": {
            "required": ["GITHUB_TOKEN"]
        },
	"observability": {
		"enabled": true
	}
}
