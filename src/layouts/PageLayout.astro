---
import "../styles/global.scss";
import Footer from "../components/Footer.astro";
import Navigation from "../components/navigation";
import { defaultLang } from "../i18n/ui";
import { getAvatarUri } from "../components/Avatar";
import { Font } from "astro:assets";


interface Props {
    title: string;
    icon?: string;
    lang?: string;
    pfpOnNavigation?: boolean;
}

const {
    title,
    icon,
    lang = (Astro.params.lang ?? defaultLang),
    pfpOnNavigation = true
} = Astro.props;
---

<html lang={lang}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{`retrozinn.dev${title != null ? ` - ${title}` : ""}`}</title>
        <link rel="icon" href={icon ?? getAvatarUri(32)} />
        <Font cssVariable="--font-fredoka" />
        <Font cssVariable="--font-cherry" />
        <style>
            body {
                max-width: 100em;
                margin-inline: auto;
            }

            @media screen and (min-width: 700px) {
                main {
                    margin-inline: 12px;
                }
            }
            @media screen and (max-width: 700px) {
                main {
                    margin-inline: 6px;
                }
            }
        </style>
        <script>
            import { getTheme } from "../scripts/theme";
            document.body.classList.add(getTheme());
        </script>
    </head>

    <body>
        <Navigation client:load {lang} showLanguageSelector={true} 
          showProfilePic={pfpOnNavigation} 
        />
        <main>
            <slot />
        </main>
    </body>
    <Footer />
</html>
