---
import ProjectsComponent from "../../components/ProjectsComponent.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import LinkButton from "../../components/LinkButton.astro";
import { useTranslations } from "../../i18n/utils";
import { getRepositories, type Repository } from "../../scripts/repos";
import { env } from "cloudflare:workers";


const tr = useTranslations(Astro.params.lang as never);
let repos: Array<Repository>|undefined;
try {
    repos = await getRepositories(undefined, {
        token: env.GITHUB_TOKEN,
        filterArchived: true,
        orderByMostStarred: true
    });
} catch(e) {
    console.error("Failed to fetch projects:", e);
}
---

<PageLayout title="Projects" maxWidth="90em">
    <h1>{ tr("projects.title") }</h1>
    <p>
        { tr("projects.description") } 
        <LinkButton href="https://github.com/retrozinndev?tab=repositories" spacing={false} external>GitHub</LinkButton>
    </p>
    <div class="projects">
        {repos && <ProjectsComponent projects={repos} />}
    </div>

    <style>
        .projects {
            display: flex;
            flex-direction: row;
            flex-wrap: wrap;
            max-width: 100%;
        }

        @media screen and (max-width:700px) {
            .projects {
                display: inline-block;
            }
        }
    
    </style>

</PageLayout>

