---
import { useTranslations }  from "../../i18n/utils";
import { getRepositories, type Repository } from "../../scripts/repos";
import { env } from "cloudflare:workers";
import PageLayout from '../../layouts/PageLayout.astro';
import SocialLinks from "../../components/SocialLinks.astro";
import LinkButton from "../../components/LinkButton.astro";
import ProjectsComponent from "../../components/ProjectsComponent.astro";
import Avatar from "../../components/Avatar";

const tr = useTranslations(Astro.params.lang as never);
let highlightProjects: Array<Repository>|undefined;

try {
    highlightProjects = (await getRepositories(undefined, {
        token: env.GITHUB_TOKEN,
        filterArchived: true,
        orderByMostStarred: true
    })).reverse().splice(0, 6); // show the first 6 projects
} catch(e) {
    console.error("Failed to fetch projects:", e);
}
---

<PageLayout title="Home" pfpOnNavigation={false}>
    <div class="card">
        <Avatar client:load loading="eager" className="gravatar" loadSize={512} size={512} />
        <div class="end">
            <div class="info">
                <h1 class="greeting">{tr("resume.title")} <span class="highlight cute">João!</span></h1>
                <p class="about">{tr("resume.description")}</p>
            </div>
            <div class="socials">
                <h2>{tr("resume.socials_title")}:</h2>
                <SocialLinks />
            </div>
        </div>
    </div>
    <div class="projects-container">
        <h1>{ tr("projects.title") }</h1>
        <p>
            { tr("projects.description") } 
            <LinkButton href="https://github.com/retrozinndev?tab=repositories"
              external={true} spacing={false}>
                GitHub
            </LinkButton>
        </p>
        <div class="projects">
            {highlightProjects && <ProjectsComponent projects={highlightProjects} />}
        </div>
    </div>

    <style lang="scss">
        @use "../../styles/colors";

        .projects-container {
            margin-inline: 1em;
        }

        $radius: 72px;
        $padding: 24px;

        .card {
            display: flex;
            background: colors.$bg-navbar-color-dark;
            width: 100%;
            height: fit-content;
            box-sizing: border-box;
            flex-direction: row;
            margin-inline: auto;
            padding: $padding;
            border-radius: $radius;
            max-width: 1400px;
            margin-bottom: 3.2em;
            gap: 5em;

            & .gravatar {
                border-radius: calc($radius - $padding);
            }

            & h1.greeting {
                font-size: 2.9em;
                font-weight: 600;
            }

            & p.about {
                font-weight: 300;
                font-size: 1.4em;
            }

            & .end {
                display: flex;
                flex-direction: column;
                gap: 3.2em;
            }

            & .info {
                flex: 1 1 content;
            }

            & .socials {
                justify-self: end;
                margin-bottom: 48px;
            }
        }

        body.light .card {
            background: colors.$bg-navbar-color-light;
        }

        /* medium */
        @media (max-width: 1100px) {
            .card {
                display: flex;
                width: 100%;
                align-items: center;
                justify-content: center;

                & .gravatar {
                    width: 256px;
                    height: 256px;
                }
            }
        }

        /* small (generally phones) */
        @media (max-width: 800px) {
            .card {
                flex-direction: column;
                gap: 1.2em;

                & .gravatar {
                    width: 100%;
                    height: 100%;
                }

                & h1, & h2, & p {
                    text-align: center
                }

                & .socials {
                    display: block;
                    text-align: center;
                }
            }

            .projects-container {
                & > h1, & > p {
                    text-align: center;
                }
            }
        }
    </style>
</PageLayout>
